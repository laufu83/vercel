{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,   
    "diagnostics": true, // 输出标准的错误和警告信息
    "extendedDiagnostics": true, // 提供更详细的错误消息和性能耗时
    "types": ["node"]
  },
  "include": ["api/**/*"],
  "exclude": ["node_modules", "dist"]
}